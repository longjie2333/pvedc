# Only used to seed a new database. Subsequent changes are made in the Web UI.
# Optional: Base32 TOTP secret; omit for first-visit QR setup.
# PDC_TOTP_SECRET=
# Optional: Base64 32-byte master key; omit to generate .data/master.key.
# PDC_MASTER_KEY=
# PDC_DATA_DIR=.data
# PDC_PUBLIC_ORIGIN=https://compute.example.edu
# PDC_PVE_URL=https://r550:8006
# PDC_PVE_NODE=r550
# PDC_PVE_TOKEN_ID=pvedc@pve!web
# PDC_PVE_TOKEN_SECRET=
# PDC_GOST_API=http://127.0.0.1:18080
# PDC_GOST_USER=pvedc
# PDC_GOST_PASSWORD=
# PDC_INITIAL_SETTINGS={"selfSelection":false,"reserveMemory":4096}
# PDC_INITIAL_CONFIG={"settings":{},"networks":[],"profiles":[],"students":[]}
